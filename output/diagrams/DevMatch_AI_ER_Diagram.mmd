        int id PK
        int user_id FK, UK
        text bio
        string phone
        string location
        string education
        string experience
        string github_url
        string linkedin_url
        string resume_path
    }
    RECRUITER_PROFILES {
        int id PK
        int user_id FK, UK
        string company_name
        text company_description
        string location
        string website
    }
    SKILLS {
        int id PK
        int developer_id FK
        string name
        string level
        float years
    }
    PROJECTS {
        int id PK
        int developer_id FK
        string name
        text description
        string github_link
        string project_link
    }
    PROJECT_TECHNOLOGIES {
        int id PK
        int project_id FK
        string name
        string category
        string version
        datetime added_at
    }
    JOBS {
        int id PK
        int recruiter_id FK
        string title
        text description
        string location
        string salary
        string experience_required
        string job_type
        date deadline
        datetime created_at
    }
    JOB_SKILLS {
        int id PK
        int job_id FK
        string name
        string importance
        float minimum_years
        datetime added_at
    }
    APPLICATIONS {
        int id PK
        int developer_id FK
        int job_id FK
        string status
        datetime created_at
    }
    RESUME_ANALYSIS {
        int id PK
        int developer_id FK
        text summary
